# ==============================================================
# Telegram Channel Copier - Environment Configuration Template
# ==============================================================
# Rename this file to .env and fill in your values.

# 1. Telegram API Credentials (Get from https://my.telegram.org)
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# 2. Telegram Bot Token (Get from https://t.me/BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ123456789

# 3. User Session String (Generate with: python generate_session.py)
# This allows the bot to access and copy from private channels without forward tags
USER_SESSION_STRING=1BVtsOHQBu7...

# 4. Authorized Admin User IDs (Comma-separated Telegram user IDs)
# Only these users can execute commands or receive bot responses.
# Find your ID using https://t.me/userinfobot
ADMIN_USER_IDS=123456789,987654321

# 5. Default Target Channel ID or Username (Optional)
# e.g. -1001987654321 or @my_target_channel
DEFAULT_TARGET_CHANNEL=-1001987654321

# 6. Delay between copied messages in seconds (Prevents FloodWait / Telegram rate limits)
DELAY_BETWEEN_MESSAGES=1.5

# 7. Posting identity to target channel:
# false: User session posts to target channel (default, works in any channel user is in)
# true:  Bot posts to target channel (Bot must be added as administrator in target channel)
COPY_AS_BOT=false
